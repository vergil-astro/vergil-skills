{
  "description": "改完 src/content 下的 Markdown 后，用站点的 directives:check 检查 Vergil 内容指令写法",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-directives.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
